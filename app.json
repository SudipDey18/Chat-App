{
  "expo": {
    "name": "CHAT-APP",
    "slug": "chat-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcons/playstore.png",
    "scheme": "chatapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/AppIcons/playstore.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCFAF6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chatapp.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/AppIcons/playstore.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chatapp.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/AppIcons/playstore.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df6dbfd3-27a9-4aac-b84c-8d9e1c6754f6"
      }
    },
    "owner": "dip018"
  }
}
